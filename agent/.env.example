# ============================================================
# Pixel-Agent — AI Provider Configuration
# ============================================================
# Copy this file to .env and fill in your keys.
# Only the keys for the selected provider are required.

# ----- Choose your provider --------------------------------
# Options: anthropic | openai | ollama | gemini
# Default: anthropic
AI_PROVIDER=ollama

# ----- Anthropic (Claude) ----------------------------------
# Get key: https://console.anthropic.com/settings/api-keys
# Pricing: pay-per-token (costs money)
ANTHROPIC_API_KEY=sk-ant-...

# ----- OpenAI (GPT) ----------------------------------------
# Get key: https://platform.openai.com/api-keys
# Pricing: pay-per-token (costs money, gpt-4o-mini is cheap)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# ----- Ollama (LOCAL — FREE) --------------------------------
# Install: curl -fsSL https://ollama.ai/install.sh | sh
# Pull model: ollama pull llama3.2
# No API key needed — runs entirely on your machine!
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ----- Google Gemini (FREE TIER) ----------------------------
# Get key: https://aistudio.google.com/apikey
# Free tier: 1 million tokens/day with gemini-1.5-flash
GEMINI_API_KEY=...
GEMINI_MODEL=gemini-1.5-flash
